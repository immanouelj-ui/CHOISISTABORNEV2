# PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-KEY"

# Stripe TEST
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Clé publique Stripe (visible côté navigateur, requise pour le paiement embarqué)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# URL publique de l'application (ex: https://choisistaborne.fr)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Authentification client
# Générer une valeur longue et aléatoire pour la production.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Resend (e-mails transactionnels : bienvenue, etc.)
# Créer une clé sur resend.com. Sans cette variable, les e-mails sont ignorés silencieusement.
RESEND_API_KEY="re_..."
# Adresse d'expédition (no-reply) — nécessite un domaine vérifié sur Resend (sinon utiliser onboarding@resend.dev pour tester).
RESEND_FROM_EMAIL="CHOISISTABORNE <ne-pas-repondre@choisistaborne.fr>"
